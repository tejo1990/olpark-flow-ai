# 문화공공데이터광장 (https://www.culture.go.kr) 오픈API 인증키 설정
# 이 파일을 복사해 `.env`로 저장한 뒤, 발급받은 인증키를 입력하세요.
#
# 참고:
# - culture.go.kr는 API별로 별도 serviceKey가 발급되는 경우가 많습니다.
# - 동일 키를 공유하는 경우 KCISA_API_KEY 하나만 입력해도 fallback으로 사용됩니다.
# - 실시간 주차현황(15168686)은 공단 공개키(PARKING21803504)가 내장되어 별도 키 없이 즉시 동작합니다.

# 공통 Fallback 키 (선택)
KCISA_API_KEY=

# 1. 올림픽공원 2025 차량입출차·공연·날씨 연계 (id=675, API_CPM_009) - 최우선 필수
KCISA_API_KEY_CPM009=

# 2. 올림픽공원 공연정보 (id=96, KSCperf)
KCISA_API_KEY_PERF=

# 3. 올림픽공원 대관정보 (id=353, getKSCD0803)
KCISA_API_KEY_RENTAL=

# 4. 올림픽공원 유실물 정보 (id=420, KSClost) - 선택
KCISA_API_KEY_LOST=

# 5. 올림픽공원 2025 입출차정보 전체구역 (id=659, API_CPM_008) - 대용량 샘플용 선택
KCISA_API_KEY_CPM008=

# 실시간 주차현황 공개키 (기본값 내장)
KSPONCO_REALTIME_PARKING_KEY=PARKING21803504
